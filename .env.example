# ──────────────────────────────────────────
# Django Core Settings
# ──────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
# SQLite — default for development (no extra setup needed)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL — recommended for production
# DATABASE_URL=postgresql://user:password@localhost:5432/canteenx

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────
# Media Files
# ──────────────────────────────────────────
MEDIA_URL=/media/

# ──────────────────────────────────────────
# Frontend URL  (password-reset link base)
# ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────
# Email (Gmail SMTP / Production)
# ──────────────────────────────────────────
# Leave EMAIL_HOST_USER empty to use safe console/file logging in development
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-campus-canteen@gmail.com
# EMAIL_HOST_PASSWORD=your-16-digit-gmail-app-password
# DEFAULT_FROM_EMAIL=CanteenX Medi-Caps <your-campus-canteen@gmail.com>

# ──────────────────────────────────────────
# WhatsApp Alerts (Twilio WhatsApp API)
# ──────────────────────────────────────────
# Leave blank to fall back to logs/whatsapp_messages.log in development
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
